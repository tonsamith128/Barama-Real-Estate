+def sandbox_library_target(root, library_path):
+    """Create *only* chroot library parent directories with traversable modes.
+
+    The aaPanel wrapper uses umask 077. Without explicit chmod, mkdir()
+    creates 0700 directories, causing execve('/php') to return EACCES for
+    non-root UID 65534 when the ELF interpreter is nested below /lib64 or /lib.
+    Chroot root and directories contain no customer files and are made 0755;
+    the host /root and the staging app are never changed.
+    """
+    pure=pathlib.PurePosixPath(library_path)
+    if (not pure.is_absolute() or '..' in pure.parts or
+            not library_path.startswith(('/lib/','/lib64/','/usr/lib/'))):
+        fail('invalid system ELF library path for sandbox')
+    root=pathlib.Path(root)
+    current=root
+    for part in pure.parts[1:-1]:
+        current=current/part
+        if current.is_symlink():
+            fail('symlink inside ephemeral library tree rejected')
+        current.mkdir(mode=0o755,exist_ok=True)
+        if not current.is_dir():
+            fail('invalid ephemeral library parent')
+        current.chmod(0o755)  # umask 077 would otherwise leave mode 0700
+    return root.joinpath(*pure.parts[1:])
+
+

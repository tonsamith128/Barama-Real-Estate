APP_NAME="Barama Real Estate"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=Asia/Phnom_Penh
LOG_CHANNEL=stack
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=barama_v2
DB_USERNAME=
DB_PASSWORD=
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
MAIL_MAILER=log

# Billing is disabled by default. Sandbox only; never use live Stripe keys.
BILLING_CHECKOUT_ENABLED=false
BILLING_STRIPE_TEST_SECRET_KEY=
BILLING_STRIPE_TEST_WEBHOOK_SECRET=

# Optional sandbox Stripe subscription billing. No production merchant activation.
BILLING_RECURRING_TEST_ENABLED=false

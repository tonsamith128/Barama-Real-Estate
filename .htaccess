Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Never expose source, runtime storage, tooling, or repository metadata.
    RewriteRule ^(?:application|tools|docs|\.github)(?:/|$) - [F,L,NC]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [QSA,L]
</IfModule>

<FilesMatch "(^\.|^(README|LICENSE|VERSION)(\..*)?$|composer\.(json|lock)$)">
    Require all denied
</FilesMatch>
